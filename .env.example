# Copy to .env in the repo root (or export in your shell). Never commit .env.

# Required for AI batch scoring
OPENAI_API_KEY=

# Optional: override default example profile (see config/profiles/README.md)
# AI_CANDIDATE_PROFILE_PATH=config/profiles/my_profile.md

# Optional: per-run acquisition caps (0 disables a source)
# LINKEDIN_MAX_RUNS=5
# INSTAHYRE_MAX_RUNS=2
# GREENHOUSE_MAX_RUNS=1
# LEVER_MAX_RUNS=1
# WEWORKREMOTELY_MAX_RUNS=1

# Optional: scoring economics (defaults are set in src/agent/ai_runtime_config.py)
# DEBUG_LIMIT=300
# BATCH_SIZE=15

# OHM Phase 4 — lifecycle monitor governance (Scheduler B)
# LIFECYCLE_MONITOR_LINKEDIN_MAX_PER_DAY=150
# LIFECYCLE_MONITOR_LINKEDIN_MAX_PER_RUN=150
# LIFECYCLE_MONITOR_INSTAHYRE_MAX_PER_DAY=500
# LIFECYCLE_MONITOR_INSTAHYRE_MAX_PER_RUN=500
# LIFECYCLE_MONITOR_JOB_DELAY_SEC=2.0
# LIFECYCLE_MONITOR_LINKEDIN_DELAY_SEC=
# LIFECYCLE_MONITOR_INSTAHYRE_DELAY_SEC=
# LIFECYCLE_MONITOR_JITTER_MAX_SEC=1.0
# LIFECYCLE_MONITOR_LINKEDIN_BACKOFF_BASE_HOURS=6
# LIFECYCLE_MONITOR_LINKEDIN_BACKOFF_MAX_HOURS=48
# LIFECYCLE_MONITOR_LINKEDIN_RESERVED_RETRY_BUDGET=0
# LIFECYCLE_MONITOR_INSTAHYRE_RESERVED_RETRY_BUDGET=0
# LIFECYCLE_MONITOR_BUDGET_TZ=Asia/Kolkata

# Optional: dashboard write actions (Operator Controls, outreach log)
# SQLITE_DASHBOARD_WRITE=1

# Optional: emergency SQLite rollback (defaults are ON for D8B — see src/db/config.py)
# SQLITE_ENABLED=0

# Optional: LinkedIn Top Applicant landing override (otherwise uses config/linkedin_queries.json)
# LINKEDIN_QUALIFICATION_LANDING_URL=
