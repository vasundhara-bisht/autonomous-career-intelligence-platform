# Copy to .env in the repo root (or export in your shell). Never commit .env.

# Required for AI batch scoring
OPENAI_API_KEY=

# Optional: override default example profile (see config/profiles/README.md)
# AI_CANDIDATE_PROFILE_PATH=config/profiles/my_profile.md

# Optional: per-run acquisition caps (0 disables a source)
# LINKEDIN_MAX_RUNS=5
# INSTAHYRE_MAX_RUNS=2
# GREENHOUSE_MAX_RUNS=1
# LEVER_MAX_RUNS=1
# WEWORKREMOTELY_MAX_RUNS=1

# Optional: scoring economics (defaults are set in src/agent/ai_runtime_config.py)
# DEBUG_LIMIT=300
# BATCH_SIZE=15

# Optional: emergency SQLite rollback (defaults are ON for D8B — see src/db/config.py)
# SQLITE_ENABLED=0

# Optional: LinkedIn Top Applicant landing override (otherwise uses config/linkedin_queries.json)
# LINKEDIN_QUALIFICATION_LANDING_URL=
